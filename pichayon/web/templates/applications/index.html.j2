{% extends 'base/default-dashboard.html.j2'%}

{% block dashboard_title%}
Room Application
{% endblock %}

{% block breadcrumbs %}
<a href="{{ url_for('applications.index')}}" class="link link-hover">Application Lists</a>
{% endblock %}

{% block content %}
<div class="bg-base-100 rounded-box shadow p-4 md:p-6">
  <div class="mb-4">
    <a class="btn btn-primary" href="{{ url_for('applications.apply')}}">
      Create Application
    </a>
  </div>

  <div class="overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>ID Number - Name</th>
          <th>Degree</th>
          <th>Advisor</th>
          <th>Room</th>
          <th>Request Date</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Purpose</th>
          <th>Remark</th>
          <th>Status</th>
          <th>Cancel</th>
        </tr>
      </thead>
      <tbody>
        {% for application in applications %}
        <tr>
          <td>{{ application.user.id_card_number }} {{ application.user.first_name }} {{ application.user.last_name }}</td>
          <td>{{ application.degree }}</td>
          <td>{{ application.advisor.first_name }} {{ application.advisor.last_name }}</td>
          <td>{{ application.room.name }}</td>
          <td>{{ application.created_date.strftime("%Y-%m-%d %H:%M") }}</td>
          <td>{{ application.started_date.strftime("%Y-%m-%d %H:%M") }}</td>
          <td>{{ application.ended_date.strftime("%Y-%m-%d %H:%M") }}</td>
          <td>{{ application.purpose }}</td>
          <td>{{ application.remark if application.remark }}</td>
          <td>{{ application.status }}</td>
          <td>
            {% if application.status == "pending" %}
            <a class="btn btn-error btn-square btn-sm"
              href="{{ url_for('applications.delete', application_id=application.id) }}">
              <i class="fa-solid fa-xmark"></i>
            </a>
            {% else %}
            <button class="btn btn-disabled btn-square btn-sm">
              <i class="fa-solid fa-xmark"></i>
            </button>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
