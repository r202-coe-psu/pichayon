{% extends '/administration/users/index.html.j2' %}
{% import '/base/html-renderer.html.j2' as renderer %}
{% block dashboard_title %}
	Edit
{% endblock %}

{%- block breadcrumbs %}
  {{ super() }}
<span class="opacity-50">/</span>
<span class="font-semibold">
  {% if 'edit' in request.path %}
    Edit {{user.username}}
  {% else %}
    Create
  {% endif %}
</span>
{%- endblock %}
{% block content %}
<div class="bg-base-100 rounded-box shadow p-4 md:p-6 max-w-2xl">
  <form method="POST">
    {{ form.csrf_token }}
    {{ renderer.render_multiple_select(form.roles) }}
    {{ renderer.render_field(form.system_id) }}
    <button type="submit" class="btn btn-primary mt-2">Update</button>
  </form>
</div>
{% endblock %}
