{% extends '/administration/index.html.j2'%}
{% import '/base/html-renderer.html.j2' as renderer %}

{% block dashboard_title%}
Applications Approval
{% endblock %}

{%- block breadcrumbs %}
{{ super() }}
<span class="opacity-50">/</span>
{% if url_for('administration.applications.index') == request.path %}
<span class="font-semibold">Applications Approval</span>
{% else %}
<a href="{{ url_for('administration.applications.index') }}" class="link link-hover">Applications Approval</a>
{% if request.path.endswith("approved") %}
<span class="opacity-50">/</span>
<span class="font-semibold">Applications Approved</span>
{% endif %}
{% endif %}
{%- endblock %}

{% block content %}
<div class="bg-base-100 rounded-box shadow p-4 md:p-6">
    {% if not request.path.endswith("approved") %}
    <div class="mb-4">
        <a class="btn btn-primary" href="{{ url_for('administration.applications.approved')}}">
            Approved Applications
        </a>
    </div>
    {% endif %}
    <div class="overflow-x-auto">
    <table class="table table-zebra">
        <thead>
            <tr>
                <th>ID Number - Name</th>
                <th>Degree</th>
                <th>Advisor</th>
                <th>Room</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Purpose</th>
                <th>Status</th>
                <th>Group</th>
                <th>Approve</th>
            </tr>
        </thead>
        <tbody>
            {% for application in paginated_applications.items %}
            <tr>
                <td>
                    <a class="link" href="{{ url_for('accounts.index', user=application.user.id) }}">
                      {{ application.user.first_name }} {{ application.user.last_name }} <br/>
                      {{ application.user.username }}
                    </a>
                </td>
                <td>{{ application.degree }}</td>
                <td>{{ application.advisor.first_name }} {{ application.advisor.last_name }}</td>
                <td>{{ application.room.name }}</td>
                <td>{{ application.started_date.strftime("%Y-%m-%d %H:%M") }}</td>
                <td>{{ application.ended_date.strftime("%Y-%m-%d %H:%M") }}</td>
                <td>{{ application.purpose }}</td>
                <td>
                    {{ application.status }}
                    {% if application.status == "rejected" %}
                    <br>({{ application.remark if application.remark }})
                    {% endif %}
                </td>
                <td>
                    {% for member in application.get_user_group_members() %}
                    <a class="link" href="{{ url_for('administration.user_groups.view', user_group_id=member.group.id) }}">
                        {{ member.group.name }}</a>
                    {% endfor %}
                </td>
                <td class="whitespace-nowrap">
                    <div class="flex gap-1">
                    {% if application.status == "pending" %}
                    <a class="btn btn-primary btn-square btn-sm"
                        href="{{ url_for('administration.applications.approve', application_id=application.id)}}">
                        <i class="fa-solid fa-check"></i>
                    </a>
                    <a class="btn btn-error btn-square btn-sm"
                        href="{{ url_for('administration.applications.reject', application_id=application.id)}}">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                    {% else %}
                    <button class="btn btn-disabled btn-square btn-sm"><i class="fa-solid fa-check"></i></button>
                    <button class="btn btn-disabled btn-square btn-sm"><i class="fa-solid fa-xmark"></i></button>
                    {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    <div class="flex justify-center mt-4">
        {{ renderer.render_pagination(paginated_applications, 'administration.applications.index' if "approved" not in request.path else 'administration.applications.approved') }}
    </div>
</div>
{% endblock %}
