{% extends '/administration/door_groups/index.html.j2' %}

{% block dashboard_title %}
	{{ door_group.name }}
{% endblock %}

{%- block breadcrumbs %}
{{ super() }}
<span class="opacity-50">/</span>
<span class="font-semibold">{{ door_group.name}}</span>
{%- endblock %}

{% block content %}
  <div class="mb-4">
    <h3 class="text-xl font-semibold mb-3">Door Group {{ door_group.name }}</h3>
    <div class="flex flex-wrap gap-2">
      <a class="btn btn-primary gap-2" href="{{ url_for('administration.door_groups.add_door', door_group_id=door_group.id) }}">
        <i class="fa-solid fa-plus"></i>Add Door
      </a>
    </div>
  </div>

  {% set members = door_group.doors %}
  <div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Status</th>
        <th>Tool</th>
      </tr>
    </thead>
    <tbody>
      {% for member in members %}
      <tr>
        <td>{{ member.name }}</td>
        <td>{{ member.device_type.title() }}</td>
        <td>{{ member.status }}</td>
        <td>
          <a href="{{ url_for('administration.door_groups.delete_door', door_group_id=door_group.id, door_id=member.id) }}" class="btn btn-circle btn-sm btn-error"><i class="fa-solid fa-trash"></i></a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
{% endblock %}
