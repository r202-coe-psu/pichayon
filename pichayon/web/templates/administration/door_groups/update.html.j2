{% extends '/administration/door_groups/index.html.j2' %}
{% import '/base/error-handler.html.j2' as eh %}

{% block content %}
<div class="bg-base-100 rounded-box shadow p-4 md:p-6 max-w-2xl">
  <h4 class="text-xl font-semibold mb-4">Update Group</h4>
  {% if errors is not undefined %}
  <div class="alert alert-error mb-3">
    <div>
      <h3 class="font-bold">Errors</h3>
      {% for error in errors %}<p>{{ error.detail }}</p>{% endfor %}
    </div>
  </div>
  {% endif %}

  <form action="{{request.path}}" method="POST">
    {{ form.csrf_token }}
    <div class="form-control w-full mb-3">
      {{ form.name.label(class_='label') }}
      {{ form.name(class_='input input-bordered w-full') }}
      {% if form.name.errors %}<span class="text-error text-sm">{{ ', '.join(form.name.errors) }}</span>{% endif %}
    </div>
    <div class="form-control w-full mb-3">
      {{ form.description.label(class_='label') }}
      {{ form.description(class_='input input-bordered w-full') }}
      {% if form.description.errors %}<span class="text-error text-sm">{{ ', '.join(form.description.errors) }}</span>{% endif %}
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
  </form>
</div>
{% endblock %}
