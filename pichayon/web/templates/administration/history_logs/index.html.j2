{% extends '/administration/index.html.j2' %}

{% block dashboard_title %}
  History Log
{% endblock %}

{%- block breadcrumbs %}
{{ super() }}
<span class="opacity-50">/</span>
{% if url_for('administration.history_logs.index') == request.path %}
  <span class="font-semibold">History Logs</span>
{% else %}
  <a href="{{ url_for('administration.history_logs.index') }}" class="link link-hover">History Logs</a>
  <span class="opacity-50">/</span>
  <span class="font-semibold">{{ door.name }}</span>
{% endif %}
{%- endblock %}

{% block content %}
  {% if logs and logs | count > 0 %}
  <div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th>Date</th>
        <th>Door</th>
        <th>Action</th>
        <th>User</th>
        <th>Via</th>
        <th>Result</th>
      </tr>
    </thead>
    <tbody>
      {% for log in logs %}
      <tr>
        <td>{{ log.log_date.ctime() }}</td>
        <td>{{ log.door.name }}</td>
        <td>
          {% if 'delete' == log.action %}
            <i class="fa-solid fa-rectangle-xmark text-error"></i>
          {% elif 'update' == log.action %}
            <i class="fa-solid fa-pen text-info"></i>
          {% elif 'create' == log.action %}
            <i class="fa-solid fa-plus text-success"></i>
          {% elif 'relock' == log.action %}
            <i class="fa-solid fa-door-closed text-error"></i>
          {% elif log.action in ['open-door', 'force-unlock'] %}
            <i class="fa-solid fa-door-open text-success"></i>
          {% endif %}
          {{ log.action | replace('-', ' ') | replace('_', ' ') | title }}
        </td>
        <td>
          {% if log.user %}
            {{ log.user.first_name }} ({{log.user.username}})
          {% else %}
            <span class="opacity-50">-</span>
          {% endif %}
        </td>
        <td>
          {% if log.details.get('type') == 'rfid' %}
            <i class="fa-solid fa-id-badge text-info"></i> RFID
          {% elif log.details.get('type') == 'web' %}
            <i class="fa-solid fa-globe text-info"></i> Web
          {% elif log.details.get('type') == 'switch' %}
            <i class="fa-solid fa-hand-point-up text-info"></i> Switch
          {% endif %}
        </td>
        <td>
          <span class="badge {{ 'badge-success' if log.message == 'success' else 'badge-error' if log.message == 'denied' else 'badge-ghost' }}">{{ log.message | title if log.message else '-' }}</span>
          {% if log.details.get('type') == 'rfid' %}
            {% set rfid = log.details.get('rfid', '') %}
            <span class="text-xs opacity-70">
              {% if log.message == 'success' %}
                {{ '*' * rfid[:-3] | length + rfid[-3:] }}
              {% else %}
                {{ rfid }}
              {% endif %}
            </span>
          {% elif log.details.get('type') == 'web' %}
            <span class="text-xs opacity-70">{{ log.details.get('ip', '') }}</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="alert alert-info">
    <span>No history logs yet.</span>
  </div>
  {% endif %}
{% endblock %}
