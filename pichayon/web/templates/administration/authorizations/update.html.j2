{% import '/base/html-renderer.html.j2' as renderer %}
{% extends '/administration/authorizations/index.html.j2' %}
{% block dashboard_title %}
{% if 'add' in request.args %}
  Add Authority
{% else %}
	Edit Authority
{% endif %}
{% endblock %}

{%- block breadcrumbs %}
{{ super() }}
<span class="opacity-50">/</span>
{% if 'add_authority' in request.path %}
  <span class="font-semibold">Add Authority</span>
{% else %}
	<span class="font-semibold">Edit Authority</span>
{% endif %}
{%- endblock %}

{% block content %}
<div class="bg-base-100 rounded-box shadow p-4 md:p-6 max-w-3xl">
  <form method="POST">
    {{ form.hidden_tag() }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {{ renderer.render_select(form.door_group) }}
      {{ renderer.render_select(form.user_group) }}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {{ renderer.render_multiple_select(form.days) }}
      {{ renderer.render_timepicker(form.start_time, timepicker_id='start_time') }}
      {{ renderer.render_timepicker(form.end_time, timepicker_id='end_time') }}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {{ renderer.render_calendar(form.started_date, calendar_id='started_date_calendar') }}
      {{ renderer.render_calendar(form.expired_date, calendar_id='ended_date_calendar') }}
    </div>
    <button class="btn btn-primary mt-2" type="submit">Confirm</button>
  </form>
</div>
{% endblock %}
