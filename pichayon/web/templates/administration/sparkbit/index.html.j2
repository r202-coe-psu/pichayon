{% extends '/administration/index.html.j2' %}

{% block dashboard_title %}
  Doors Management
{% endblock %}

{%- block breadcrumbs %}
{{ super() }}
<span class="opacity-50">/</span>
{% if url_for('administration.doors.index') == request.path %}
  <span class="font-semibold">Doors Management</span>
{% else %}
  <a href="{{ url_for('administration.doors.index') }}" class="link link-hover">Doors Management</a>
  <a href="{{ url_for('administration.sparkbit.index') }}" class="link link-hover">Sparkbit Door</a>
{% endif %}
{%- endblock %}

{% block content %}
  <div class="mb-4 flex flex-wrap gap-2">
    <a class="btn btn-primary gap-2" href="{{ url_for('administration.sparkbit.create') }}">
      <i class="fa-solid fa-plus"></i>Create Sparkbit Door
    </a>
  </div>

  {% if sparkbit_door_systems | count > 0 %}
  <div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table table-zebra">
    <thead>
      <tr>
        <th>Door</th>
        <th>Name</th>
        <th>Description</th>
        <th>Device ID</th>
        <th>Creator</th>
        <th>Updated Date</th>
        <th>Operation</th>
      </tr>
    </thead>
    <tbody>
	    {% for sb_door in sparkbit_door_systems %}
      <tr>
	      <td><a class="link" href="{{ url_for('administration.doors.index') }}">{{ sb_door.door.name }}</a></td>
	      <td>{{ sb_door.name }}</td>
        <td>{{ sb_door.description }}</td>
        <td>{{ sb_door.device_id }}</td>
        <td>{{ sb_door.creator.username }}</td>
        <td>{{ sb_door.updated_date.ctime() }}</td>
        <td class="whitespace-nowrap">
          <a href="{{ url_for('administration.sparkbit.edit', sparkbit_door_id=sb_door.id) }}" class="btn btn-circle btn-sm btn-warning"><i class="fa-solid fa-pen"></i></a>
          <a href="{{ url_for('administration.sparkbit.delete', sparkbit_door_id=sb_door.id) }}" class="btn btn-circle btn-sm btn-error"><i class="fa-solid fa-trash"></i></a>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="alert alert-info">
    <span>Don't have any Sparkbit Door System.</span>
  </div>
  {% endif %}
{% endblock %}
