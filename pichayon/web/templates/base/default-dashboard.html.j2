{% extends "/base/base-layout.html.j2" %}

{% block title %}{{ config.get('APP_TITLE') }} Dashboard{% endblock %}

{% block body %}
<div class="drawer lg:drawer-open">
  <input id="dashboard-drawer" type="checkbox" class="drawer-toggle" />

  {# ---- main content side ---- #}
  <div class="drawer-content flex flex-col min-h-screen bg-base-200">

    {# top bar (hamburger shown on mobile, hidden on lg where the sidebar is pinned) #}
    <div class="navbar bg-neutral text-neutral-content lg:hidden sticky top-0 z-30">
      <div class="flex-none">
        <label for="dashboard-drawer" class="btn btn-square btn-ghost" aria-label="open sidebar">
          <i class="fa-solid fa-bars text-lg"></i>
        </label>
      </div>
      <div class="flex-1 px-2 font-semibold">{% block dashboard_title %}Dashboard{% endblock %}</div>
    </div>

    {# desktop page header #}
    <header class="hidden lg:block bg-base-100 border-b border-base-300">
      <div class="px-6 py-4">
        <h1 class="text-2xl font-bold">{{ self.dashboard_title() }}</h1>
      </div>
    </header>

    <main class="flex-1 p-4 md:p-6">
      {%- if self.dashboard_title().lower() != 'dashboard' %}
      <div class="text-sm mb-4 bg-base-100 rounded-box px-4 py-2 shadow-sm flex flex-wrap items-center gap-2">
        {% block breadcrumbs %}{% endblock %}
      </div>
      {% endif -%}
{% block content %}{% endblock %}
    </main>

    <footer class="bg-neutral text-neutral-content mt-8">
{% include "/base/footer.html.j2" %}
    </footer>
  </div>

  {# ---- sidebar side ---- #}
  <div class="drawer-side z-40">
    <label for="dashboard-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <aside class="w-64 min-h-full bg-neutral text-neutral-content">
      <ul class="menu p-4 gap-1 w-full">
        {% include "/base/menu-dashboard.html.j2" with context %}
      </ul>
    </aside>
  </div>
</div>
{% endblock body %}
