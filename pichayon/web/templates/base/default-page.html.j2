{% extends "/base/base-layout.html.j2" %}
{% block body %}
<div class="flex flex-col min-h-screen">
<header>
{% block header %}
  {% include "/base/menu.html.j2" %}
  {% if request.path == '/' %}
    {% include "/base/banner.html.j2" %}
  {% endif %}
{% endblock %}
</header>

<main class="flex-1">
  <div class="container mx-auto px-4 py-6">
    {% block content %}{% endblock content %}
  </div>
</main>

<footer class="bg-neutral text-neutral-content mt-8">
{% include "/base/footer.html.j2" %}
</footer>
</div>
{% endblock %}
