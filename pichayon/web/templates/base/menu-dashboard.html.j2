  {{ nav_link('administration.user_groups.index', 'fa-user-group', 'User Groups', blueprint='administration.user_groups') }}
  {{ nav_link('administration.authorizations.index', 'fa-user-shield', 'Authorization', blueprint='administration.authorizations') }}
  {{ nav_link('administration.history_logs.index', 'fa-clock-rotate-left', 'History Log', blueprint='administration.history_logs') }}
  {{ nav_link('administration.users.index', 'fa-users', 'Users', blueprint='administration.users') }}
  {{ nav_link('administration.applications.index', 'fa-list-check', 'Admin Applications Approval', blueprint='administration.applications') }}
{% endif %}

{{ nav_link('applications.index', 'fa-address-card', 'Door Application') }}
