{% macro nav_link(endpoint, icon, label, blueprint=none) -%}
{%- set is_active = (blueprint and request.blueprint == blueprint) or url_for(endpoint) == request.path -%}
<li><a href="{{ url_for(endpoint) }}" class="{{ 'active' if is_active }}"><i class="fa-solid {{ icon }} w-5"></i>{{ label }}</a></li>
{%- endmacro %}

<li class="mb-2">
  <a href="{{ url_for('accounts.index') }}" class="flex items-center gap-3">
  {%- if current_user.get_image() %}
    <div class="avatar">
      <div class="w-10 rounded-full">
        <img src="{{ current_user.get_image() }}">
      </div>
    </div>
  {% endif -%}
    <div class="flex flex-col">
      <span class="font-semibold">{{ current_user.first_name }} {{ current_user.last_name }}</span>
      <span class="text-xs opacity-70">{{ current_user.email }}</span>
    </div>
  </a>
</li>

{{ nav_link('dashboard.index', 'fa-gauge-high', 'Dashboard') }}

{% if current_user.has_roles('lecturer') %}
{{ nav_link('applications.approve', 'fa-list-check', 'Applications Approval') }}
{% endif %}

{% if current_user.has_roles('admin') %}
  {{ nav_link('administration.doors.index', 'fa-door-closed', 'Door Manager', blueprint='administration.doors') }}
